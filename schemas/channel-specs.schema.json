{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/channel-specs.schema.json",
  "title": "CHANNEL-SPECS.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "channel",
        "placement",
        "language_market",
        "source",
        "source_authority",
        "checked_at",
        "confidence",
        "file_types"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-[0-9]{3,}$"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "language_market": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_authority": {
          "enum": [
            "official",
            "regulator",
            "first_party",
            "internal"
          ]
        },
        "checked_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+[x×][0-9]+$"
          }
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?[:/][0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "duration_seconds": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "file_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9]+$"
          }
        },
        "file_size_limit_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "text_constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "safe_zone_notes": {
          "type": "string"
        },
        "caption_requirements": {
          "type": "string"
        }
      }
    }
  }
}
