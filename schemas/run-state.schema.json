{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/run-state.schema.json",
  "title": "run-state.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "objective",
    "mode",
    "phase",
    "readiness",
    "performance",
    "external_action_authorized",
    "open_decisions",
    "blocking_findings",
    "artifacts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "RESEARCH",
        "POSITION",
        "CAMPAIGN",
        "COPY",
        "STATIC",
        "IMAGE",
        "VIDEO",
        "LAUNCH-KIT",
        "EXPERIMENT",
        "LOCALIZE",
        "AUDIT",
        "MEASURE"
      ]
    },
    "specialty": {
      "type": "string",
      "minLength": 1
    },
    "specialty_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "specialty_matched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specialty_reference": {
      "type": "string",
      "pattern": "^vendor/marketingskills/skills/[a-z0-9-]+/SKILL\\.md$"
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "enum": [
        "DRAFT",
        "REVIEW_READY",
        "LAUNCH_READY",
        "BLOCKED"
      ]
    },
    "performance": {
      "enum": [
        "NOT_MEASURED",
        "MEASURING",
        "PERFORMANCE_VALIDATED"
      ]
    },
    "external_action_authorized": {
      "const": false
    },
    "open_decisions": {
      "type": "array"
    },
    "blocking_findings": {
      "type": "array"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ASSET-[0-9]{3,}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
