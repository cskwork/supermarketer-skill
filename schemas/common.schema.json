{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/common.schema.json",
  "title": "SuperMarketer common definitions",
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^[PCMSLA]-[0-9]{3,}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^CL-[0-9]{3,}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^ASSET-[0-9]{3,}$"
    },
    "deliverableId": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^RV-[0-9]{3,}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^AP-[0-9]{3,}$"
    },
    "packId": {
      "type": "string",
      "pattern": "^PK-[0-9]{3,}$"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/]|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))"
      }
    }
  }
}
