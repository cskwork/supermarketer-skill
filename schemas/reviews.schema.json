{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/reviews.schema.json",
  "title": "REVIEWS.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "severity",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "blocker"
          ]
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "accepted_by": {
          "type": "string"
        },
        "accepted_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "reviewer",
        "completed_at",
        "verdict",
        "asset_ids",
        "findings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RV-[0-9]{3,}$"
        },
        "type": {
          "enum": [
            "research_method",
            "strategy",
            "claims_brand_rights",
            "creative",
            "accessibility",
            "localization",
            "compliance",
            "artifact_qa",
            "measurement"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "verdict": {
          "enum": [
            "pass",
            "pass_with_risk",
            "fail"
          ]
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ASSET-[0-9]{3,}$"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
