{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/approvals.schema.json",
  "title": "APPROVALS.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "type",
          "decision",
          "recorded_from",
          "user_quote",
          "approver",
          "approved_at",
          "expires_at",
          "actions",
          "asset_ids",
          "destination",
          "account",
          "timing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AP-[0-9]{3,}$"
          },
          "type": {
            "const": "publish"
          },
          "decision": {
            "enum": [
              "approved",
              "rejected",
              "revoked"
            ]
          },
          "recorded_from": {
            "const": "user_explicit"
          },
          "user_quote": {
            "type": "string",
            "minLength": 4
          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "publish",
                "send",
                "schedule",
                "spend"
              ]
            }
          },
          "asset_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ASSET-[0-9]{3,}$"
            }
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 1
          },
          "timing": {
            "type": "string",
            "minLength": 1
          },
          "recipient_scope": {
            "type": "string"
          },
          "budget_currency": {
            "type": "string"
          },
          "budget_max": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
