{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supermarketer.local/schemas/deliverables.schema.json",
  "title": "DELIVERABLES.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliverables"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deliverable"
      }
    }
  },
  "$defs": {
    "deliverable": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "description",
        "kind",
        "channel",
        "placement",
        "language_market",
        "required",
        "fallback_allowed",
        "fulfillment_asset_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-[0-9]{3,}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "research",
            "strategy",
            "copy",
            "static",
            "image",
            "video",
            "audio",
            "document",
            "data"
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "language_market": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "expected_dimensions": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+[x×][0-9]+$"
        },
        "expected_duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "fallback_allowed": {
          "type": "boolean"
        },
        "fallback_accepted_by": {
          "type": "string"
        },
        "fulfillment_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ASSET-[0-9]{3,}$"
          }
        }
      }
    }
  }
}
